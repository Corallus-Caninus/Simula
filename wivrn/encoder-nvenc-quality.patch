diff -ruN wvo/server/encoder/video_encoder_nvenc.cpp wvp/server/encoder/video_encoder_nvenc.cpp
--- a/server/encoder/video_encoder_nvenc.cpp	2026-10-04 16:51:17.169252192 +0000
+++ b/server/encoder/video_encoder_nvenc.cpp	2026-10-04 16:51:09.594226376 +0000
@@ -134,14 +134,19 @@
 
 NV_ENC_RC_PARAMS video_encoder_nvenc::get_rc_params(uint64_t bitrate, float framerate)
 {
+	// SIMULA PATCH: favour compression quality over the most aggressive
+	// low-latency mode (which produced visible artifacts at streaming
+	// bitrates). CBR + a 2-frame VBV is still low latency, but we enable
+	// lookahead and full-resolution multi-pass so NVENC spends the bits
+	// better. (Client maxes the bitrate; the two eyes now get all of it.)
 	return {
 	        .rateControlMode = NV_ENC_PARAMS_RC_CBR,
 	        .averageBitRate = static_cast<uint32_t>(bitrate),
 	        .vbvBufferSize = static_cast<uint32_t>(bitrate / framerate * 2.0f),
 	        .vbvInitialDelay = static_cast<uint32_t>(bitrate / framerate),
-	        .enableLookahead = 0,
+	        .enableLookahead = 1,
 	        .lowDelayKeyFrameScale = 1,
-	        .multiPass = NV_ENC_TWO_PASS_QUARTER_RESOLUTION};
+	        .multiPass = NV_ENC_TWO_PASS_FULL_RESOLUTION};
 }
 
