+
+// Legacy helpers used by the software-encode FormatConverter path.
+
+uint32_t
+Renderer::memoryTypeIndex(VkMemoryPropertyFlags wanted, VkMemoryPropertyFlags have)
+{
+    auto props = m_physDev.getMemoryProperties(m_d);
+    for (u32 i = 0; i < props.memoryTypeCount; ++i) {
+        auto flags = static_cast<VkMemoryPropertyFlags>(props.memoryTypes[i].propertyFlags);
+        if ((flags & wanted) == wanted && have & (1u << i)) {
+            return i;
+        }
+    }
+    return 0xFFFFFFFFu;
+}
+
+void
+Renderer::commandBufferBegin()
+{
+    vk::CommandBufferAllocateInfo allocInfo {
+        .commandPool = m_commandPool,
+        .commandBufferCount = 1,
+    };
+    m_commandBuffer = m_dev.allocateCommandBuffers(allocInfo)[0];
+    m_commandBuffer.begin(vk::CommandBufferBeginInfo { .flags = vk::CommandBufferUsageFlagBits::eOneTimeSubmit });
+}
+
+void
+Renderer::commandBufferSubmit()
+{
+    m_commandBuffer.end();
+    vk::Queue queue(m_queue);
+    vk::SubmitInfo submitInfo {
+        .commandBufferCount = 1,
+        .pCommandBuffers = &m_commandBuffer,
+    };
+    queue.submit(submitInfo, m_fence);
+    m_dev.waitForFences(m_fence, true, UINT64_MAX);
+    m_dev.resetFences(m_fence);
+    m_dev.freeCommandBuffers(m_commandPool, m_commandBuffer);
+    m_commandBuffer = VK_NULL_HANDLE;
+}
